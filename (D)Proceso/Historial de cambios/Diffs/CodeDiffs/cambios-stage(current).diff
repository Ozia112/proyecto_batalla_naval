+char encode_value(int v) {
+    if(v == UNSET) return 'F';
+    return '0' + v; // Convertir a carácter numérico
+}
+
+int decode_value(char c) {
+    if (c == 'F') return UNSET;
+    return c - '0'; // Convertir de carácter numérico a entero
+}
