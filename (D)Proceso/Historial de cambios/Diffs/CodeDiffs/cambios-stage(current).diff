+        card_obj = cJSON_GetArrayItem(cards_array, i);
+        if (card_obj && cJSON_IsObject(card_obj)) {
+            UPDATE_STRUCT_NUM_OBJ(card, peso, card_obj, "weight");
+        }
+    }
+}
